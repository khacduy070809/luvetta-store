{%- comment -%}
Luvetta Gift Assistant — khung chat AI agent
Cài: Online Store → Themes → Edit code → Snippets → Add a new snippet "luvetta-agent"
rồi thêm {% render 'luvetta-agent' %} ngay trước </body> trong layout/theme.liquid
{%- endcomment -%}
<div id="lv-agent">
<style>
#lv-agent{--lv-bg:#FFF7F3;--lv-soft:#F8EAE3;--lv-rose:#B47E70;--lv-choc:#56392F;--lv-text:#5F4B43;--lv-gold:#C39762;--lv-line:#EAD7C9;font-family:inherit;color:var(--lv-text)}
#lv-agent *{box-sizing:border-box}
#lv-agent .lv-fab{position:fixed;right:20px;bottom:20px;z-index:2147483000;width:60px;height:60px;border-radius:50%;border:0;background:var(--lv-rose);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(86,57,47,.25)}
#lv-agent .lv-fab svg{width:28px;height:28px}
#lv-agent .lv-panel{position:fixed;right:20px;bottom:92px;z-index:2147483000;width:370px;max-width:calc(100vw - 24px);height:560px;max-height:calc(100vh - 120px);background:var(--lv-bg);border:1px solid var(--lv-line);border-radius:20px;display:none;flex-direction:column;overflow:hidden;box-shadow:0 12px 40px rgba(86,57,47,.18)}
#lv-agent.lv-open .lv-panel{display:flex}
#lv-agent .lv-head{padding:14px 16px;background:var(--lv-soft);border-bottom:1px solid var(--lv-line);display:flex;align-items:center;gap:10px}
#lv-agent .lv-head b{color:var(--lv-choc);font-size:16px;display:block}
#lv-agent .lv-head small{font-size:12px;opacity:.8}
#lv-agent .lv-x{margin-left:auto;background:none;border:0;font-size:22px;color:var(--lv-choc);cursor:pointer;line-height:1}
#lv-agent .lv-log{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
#lv-agent .lv-msg{max-width:85%;padding:10px 13px;border-radius:16px;font-size:14px;line-height:1.5;word-wrap:break-word}
#lv-agent .lv-bot{background:var(--lv-soft);border:1px solid var(--lv-line);align-self:flex-start;border-bottom-left-radius:4px}
#lv-agent .lv-user{background:var(--lv-rose);color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
#lv-agent .lv-msg a{color:var(--lv-choc);text-decoration:underline}
#lv-agent .lv-cartbtn{align-self:flex-start;background:var(--lv-choc);color:#fff;text-decoration:none;font-size:13px;padding:8px 14px;border-radius:999px}
#lv-agent .lv-dbg{align-self:stretch;font-family:monospace;font-size:11px;line-height:1.4;color:#7a6a63;background:#fff;border:1px dashed var(--lv-line);border-radius:8px;padding:6px 8px;word-break:break-all}
#lv-agent .lv-typing{align-self:flex-start;font-size:13px;opacity:.7;padding:0 4px}
#lv-agent .lv-chips{display:flex;flex-wrap:wrap;gap:6px;padding:0 16px 10px}
#lv-agent .lv-chips button{border:1px solid var(--lv-rose);background:#fff;color:var(--lv-rose);border-radius:999px;font-size:12px;padding:6px 11px;cursor:pointer}
#lv-agent form{display:flex;gap:8px;padding:12px;border-top:1px solid var(--lv-line);background:#fff}
#lv-agent input{flex:1;border:1px solid var(--lv-line);border-radius:999px;padding:10px 14px;font:inherit;font-size:14px;color:var(--lv-text);outline:none}
#lv-agent input:focus{border-color:var(--lv-rose)}
#lv-agent form button{border:0;background:var(--lv-rose);color:#fff;border-radius:999px;padding:0 16px;font-size:14px;cursor:pointer}
#lv-agent form button:disabled{opacity:.5;cursor:default}
@media (max-width:480px){#lv-agent .lv-panel{right:0;left:0;bottom:0;width:100%;max-width:100%;height:85vh;max-height:85vh;border-radius:20px 20px 0 0}#lv-agent.lv-open .lv-fab{display:none}}
</style>

<button class="lv-fab" type="button" aria-label="Chat with Luvetta gift assistant" aria-expanded="false">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
</button>

<div class="lv-panel" role="dialog" aria-label="Luvetta gift assistant">
<div class="lv-head">
<div><b>Luvetta ♡ Gift Assistant</b><small>AI assistant · here to help you pick</small></div>
<button class="lv-x" type="button" aria-label="Close chat">×</button>
</div>
<div class="lv-log" aria-live="polite"></div>
<div class="lv-chips"></div>
<form autocomplete="off">
<input type="text" maxlength="500" placeholder="Ask me anything…" aria-label="Your message">
<button type="submit">Send</button>
</form>
</div>

<script>
(function () {
/* ============ CẤU HÌNH — CHỈ SỬA PHẦN NÀY ============ */
var CONFIG = {
endpoint: 'https://luvetta-agent.khacduy070809.workers.dev', // URL Worker sau khi deploy
productHandle: 'tiny-heart-initial-necklace-gold-silver',                // phần cuối URL trang sản phẩm
bundleActive: false, // chỉ đổi thành true khi discount Buy 2 Get 1 đã bật thật trong Shopify Discounts
bundleText: 'Buy 2, Get 1 Free: add 3 necklaces to your cart (any letters and colors).',
// Chỉ điền thông tin ĐÃ XÁC MINH. Để trống thì agent sẽ không đoán mà đưa link chính sách.
storeInfo: {
shipping: '',
returns: '',
materials: '',
sizing: '',
contact: ''
},
debug: false, // true = hiện các bước agent gọi công cụ + lỗi chi tiết (để test/chụp báo cáo). Đổi false khi dùng thật
greeting: "Hi there ♡ Looking for a little gift, or something just for you? I can help you pick the perfect initial."
};
/* ===================================================== */

var ROOT = ({{ routes.root_url | json }} || '/').replace(/\/?$/, '/');
var CURRENCY = {{ cart.currency.iso_code | json }} || 'USD';
var STORE_KEY = 'lv_agent_v1';
var el = document.getElementById('lv-agent');
var fab = el.querySelector('.lv-fab'), logEl = el.querySelector('.lv-log'), chipsEl = el.querySelector('.lv-chips');
var form = el.querySelector('form'), input = form.querySelector('input'), sendBtn = form.querySelector('button');
var history = [], shown = [], variants = null, busy = false;

/* ---------- tiện ích ---------- */
function money(n) { try { return new Intl.NumberFormat('en-US', { style: 'currency', currency: CURRENCY }).format(n); } catch (e) { return '$' + n.toFixed(2); } }
function normLetter(x) { var m = String(x || '').match(/[A-Za-z]/); return m ? m[0].toUpperCase() : null; }
function normColor(x) { var s = String(x || ''); return /gold/i.test(s) ? 'Gold' : /silver/i.test(s) ? 'Silver' : null; }
function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
function render(s) {
return esc(s)
.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
.replace(/(https?:\/\/[^\s<]+|\/(?:cart|policies\/[a-z-]+|pages\/[a-z-]+)\b)/g, '<a href="$1">$1</a>')
.replace(/\n/g, '<br>');
}
function save() { try { sessionStorage.setItem(STORE_KEY, JSON.stringify({ h: history, s: shown })); } catch (e) {} }
function restore() { try { var d = JSON.parse(sessionStorage.getItem(STORE_KEY) || 'null'); if (d) { history = d.h || []; shown = d.s || []; } } catch (e) {} }

/* ---------- giao diện ---------- */
function addMsg(who, text, keep) {
if (who === 'cart') {
var a = document.createElement('a'); a.className = 'lv-cartbtn'; a.href = ROOT + 'cart'; a.textContent = 'View cart →'; logEl.appendChild(a);
} else if (who === 'dbg') {
if (!CONFIG.debug) return;
var g = document.createElement('div'); g.className = 'lv-dbg'; g.textContent = text; logEl.appendChild(g);
} else {
var d = document.createElement('div'); d.className = 'lv-msg ' + (who === 'user' ? 'lv-user' : 'lv-bot'); d.innerHTML = render(text); logEl.appendChild(d);
}
if (keep !== false) { shown.push({ w: who, t: text }); save(); }
logEl.scrollTop = logEl.scrollHeight;
}
function setBusy(b) {
busy = b; sendBtn.disabled = b;
var t = logEl.querySelector('.lv-typing');
if (b && !t) { t = document.createElement('div'); t.className = 'lv-typing'; t.textContent = 'Luvetta is typing…'; logEl.appendChild(t); logEl.scrollTop = logEl.scrollHeight; }
if (!b && t) t.remove();
}
function drawChips() {
chipsEl.innerHTML = '';
if (shown.some(function (m) { return m.w === 'user'; })) return;
var chips = ['Help me pick a gift ♡', 'Gold or Silver?', 'Which letter should I choose?'];
if (CONFIG.bundleActive) chips.push('Tell me about Buy 2 Get 1');
chips.forEach(function (c) { var b = document.createElement('button'); b.type = 'button'; b.textContent = c; b.onclick = function () { ask(c); }; chipsEl.appendChild(b); });
}
function toggle(open) {
el.classList.toggle('lv-open', open); fab.setAttribute('aria-expanded', open);
if (open && !shown.length) addMsg('bot', CONFIG.greeting);
if (open) { drawChips(); setTimeout(function () { input.focus(); }, 50); }
}

/* ---------- dữ liệu Shopify ---------- */
function parseVariant(v) {
var letter = null, color = null;
[v.option1, v.option2, v.option3].forEach(function (o) {
if (!o) return; var s = String(o).trim();
var m = s.match(/^(?:letter|initial)?\s*([A-Za-z])$/i);
if (m && !letter) letter = m[1].toUpperCase(); else if (!color && normColor(s)) color = normColor(s);
});
return { id: v.id, letter: letter, color: color, price: v.price / 100, available: v.available };
}
function loadVariants() {
if (variants) return Promise.resolve(variants);
return fetch(ROOT + 'products/' + CONFIG.productHandle + '.js').then(function (r) {
if (!r.ok) throw new Error('Product not found — check productHandle');
return r.json();
}).then(function (p) { variants = p.variants.map(parseVariant).filter(function (v) { return v.letter && v.color; }); return variants; });
}
function cartSummary() {
return fetch(ROOT + 'cart.js').then(function (r) { return r.json(); }).then(function (c) {
return { item_count: c.item_count, items: c.items.map(function (i) { return i.product_title + ' — ' + (i.variant_title || '') + ' × ' + i.quantity + ' (' + money(i.final_line_price / 100) + ')'; }), subtotal: money(c.total_price / 100) };
});
}
function refreshCartUI() {
document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
var bubble = document.getElementById('cart-icon-bubble'); // theme Dawn và theme dựa trên Dawn
if (!bubble) return;
fetch(ROOT + '?sections=cart-icon-bubble').then(function (r) { return r.json(); }).then(function (s) {
if (!s['cart-icon-bubble']) return;
var doc = new DOMParser().parseFromString(s['cart-icon-bubble'], 'text/html');
var inner = doc.querySelector('.shopify-section'); bubble.innerHTML = (inner || doc.body).innerHTML;
}).catch(function () {});
}

/* ---------- CÔNG CỤ của agent (chạy trên trình duyệt) ---------- */
var TOOLS = {
check_options: function (a) {
return loadVariants().then(function (vs) {
var L = normLetter(a.letter), C = normColor(a.color), list = vs.filter(function (v) { return (!L || v.letter === L) && (!C || v.color === C); });
if (L && C) {
var v = list[0];
return v ? { found: true, letter: v.letter, color: v.color, price: money(v.price), in_stock: v.available } : { found: false, message: 'This letter/color combination does not exist.' };
}
var uniq = function (arr) { return arr.filter(function (x, i) { return arr.indexOf(x) === i; }); };
return {
letters_in_stock: uniq(list.filter(function (v) { return v.available; }).map(function (v) { return v.letter; })).sort().join(' '),
colors: uniq(list.map(function (v) { return v.color; })),
prices: uniq(list.map(function (v) { return money(v.price); })),
sold_out: list.filter(function (v) { return !v.available; }).map(function (v) { return v.letter + ' ' + v.color; }).slice(0, 20)
};
});
},
add_to_cart: function (a) {
var items = Array.isArray(a.items) ? a.items : [];
if (!items.length) return Promise.resolve({ ok: false, error: 'No items given.' });
if (items.length > 3) return Promise.resolve({ ok: false, error: 'Maximum 3 necklaces at a time.' });
return loadVariants().then(function (vs) {
var lines = {}, labels = [];
for (var i = 0; i < items.length; i++) {
var L = normLetter(items[i].letter), C = normColor(items[i].color);
var v = vs.filter(function (x) { return x.letter === L && x.color === C; })[0];
if (!v) return { ok: false, error: (items[i].letter + ' ' + items[i].color) + ' was not found.' };
if (!v.available) return { ok: false, error: L + ' ' + C + ' is sold out.' };
lines[v.id] = (lines[v.id] || 0) + 1; labels.push(L + ' ' + C);
}
var payload = Object.keys(lines).map(function (id) { return { id: Number(id), quantity: lines[id] }; });
return fetch(ROOT + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: payload }) })
.then(function (r) { return r.json().then(function (d) { return { r: r, d: d }; }); })
.then(function (x) {
if (!x.r.ok) return { ok: false, error: x.d.description || x.d.message || 'Could not add to cart.' };
refreshCartUI(); addMsg('cart', '');
return cartSummary().then(function (c) { return { ok: true, added: labels, cart: c }; });
});
});
},
view_cart: function () { return cartSummary(); },
get_store_info: function (a) {
var links = { shipping: ROOT + 'policies/shipping-policy', returns: ROOT + 'policies/refund-policy', contact: ROOT + 'pages/contact' };
if (a.topic === 'bundle') return Promise.resolve(CONFIG.bundleActive ? { active: true, info: CONFIG.bundleText } : { active: false, info: 'No bundle offer is active right now. Do not mention one.' });
var t = CONFIG.storeInfo[a.topic];
return Promise.resolve(t ? { info: t, link: links[a.topic] || null } : { info: null, note: 'Not confirmed by the shop. Do not guess.', link: links[a.topic] || null });
}
};

/* ---------- vòng lặp agent ---------- */
function trimHistory() {
if (history.length <= 24) return;
for (var i = history.length - 24; i < history.length; i++) {
var p = history[i];
if (p.role === 'user' && p.parts[0] && typeof p.parts[0].text === 'string') { history = history.slice(i); return; }
}
}
function callWorker() {
return fetch(CONFIG.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: history }) })
.then(function (r) {
return r.json().catch(function () { return {}; }).then(function (d) {
if (r.status === 429) throw new Error('rate_limited');
if (!r.ok) { var e = new Error('server'); e.detail = 'HTTP ' + r.status + ' ' + (d.error || '') + ' ' + (d.detail || ''); throw e; }
return d;
});
});
}
function step(round) {
if (round > 6) { addMsg('dbg', '⚠ stopped: too many tool rounds'); addMsg('bot', "Sorry, I got a little stuck. Could you tell me again what you're looking for? ♡"); return Promise.resolve(); }
return callWorker().then(function (res) {
var content = res.content; content.role = 'model'; history.push(content);
var text = content.parts.filter(function (p) { return p.text && !p.thought; }).map(function (p) { return p.text; }).join('').trim();
if (text) addMsg('bot', text);
var calls = content.parts.filter(function (p) { return p.functionCall; });
if (!calls.length) { if (!text) addMsg('dbg', '⚠ empty reply: ' + JSON.stringify(content).slice(0, 180)); save(); return; }
return Promise.all(calls.map(function (c) {
var fc = c.functionCall, fn = TOOLS[fc.name];
var run = fn ? Promise.resolve().then(function () { return fn(fc.args || {}); }) : Promise.resolve({ error: 'Unknown tool' });
return run.catch(function (e) { return { error: String(e && e.message || e) }; }).then(function (out) {
addMsg('dbg', '🔧 ' + fc.name + '(' + JSON.stringify(fc.args || {}) + ') → ' + JSON.stringify(out).slice(0, 180));
var fr = { name: fc.name, response: out }; if (fc.id) fr.id = fc.id; return { functionResponse: fr };
});
})).then(function (parts) { history.push({ role: 'user', parts: parts }); return step(round + 1); });
});
}
function ask(text) {
text = String(text || '').trim(); if (!text || busy) return;
chipsEl.innerHTML = ''; addMsg('user', text);
var mark = history.length;
history.push({ role: 'user', parts: [{ text: text }] }); trimHistory(); setBusy(true);
step(1).catch(function (e) {
history = history.slice(0, Math.min(mark, history.length));
addMsg('dbg', '❌ ' + (e.message || e) + (e.detail ? ' | ' + e.detail : ''));
addMsg('bot', e.message === 'rate_limited' ? "I'm getting lots of questions right now. Please try again in a minute ♡" : "Sorry, something went wrong on my side. Please try again in a moment.");
}).then(function () { setBusy(false); save(); });
}

/* ---------- khởi động ---------- */
restore();
shown.forEach(function (m) { addMsg(m.w, m.t, false); });
fab.addEventListener('click', function () { toggle(!el.classList.contains('lv-open')); });
el.querySelector('.lv-x').addEventListener('click', function () { toggle(false); });
form.addEventListener('submit', function (e) { e.preventDefault(); var t = input.value; input.value = ''; ask(t); });
document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && el.classList.contains('lv-open')) toggle(false); });
})();
</script>
</div>