{% doc %}
  @prompt
    Create a countdown timer banner to place above the header. Requirements:
    - Counts down exactly 3 hours from first visit using localStorage to persist across page refreshes
    - Displays bold text "DEAL ENDS IN:" followed by live countdown in HH:MM:SS format
    - When timer reaches zero, the entire banner hides permanently (use localStorage to remember, never resets)
    - Eye-catching design: red or dark background, white bold text, centered
    - Pure HTML/CSS/JavaScript only, no external libraries
    - Implement as a Shopify Liquid section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 20px;
    text-align: center;
    position: relative;
    z-index: 1000;
  }

  .ai-countdown-banner-{{ ai_gen_id }}.ai-countdown-hidden-{{ ai_gen_id }} {
    display: none;
  }

  .ai-countdown-banner__content-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.text_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-countdown-banner__label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    letter-spacing: 0.5px;
    margin: 0;
  }

  .ai-countdown-banner__timer-{{ ai_gen_id }} {
    color: {{ block.settings.timer_color }};
    font-size: {{ block.settings.timer_font_size }}px;
    font-weight: {{ block.settings.timer_font_weight }};
    font-family: monospace;
    letter-spacing: 1px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-banner__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.85 }}px;
    }

    .ai-countdown-banner__timer-{{ ai_gen_id }} {
      font-size: {{ block.settings.timer_font_size | times: 0.85 }}px;
    }

    .ai-countdown-banner__content-{{ ai_gen_id }} {
      gap: {{ block.settings.text_spacing | times: 0.7 }}px;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-banner-{{ ai_gen_id }}"
  data-duration="{{ block.settings.countdown_hours }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-countdown-banner__content-{{ ai_gen_id }}">
    <p class="ai-countdown-banner__label-{{ ai_gen_id }}">{{ block.settings.banner_text }}</p>
<p class="ai-countdown-banner__timer-{{ ai_gen_id }}" id="ai-countdown-timer-{{ ai_gen_id }}">00:00:00</p>
<p class="ai-countdown-banner__label-{{ ai_gen_id }}">— Free Shipping included</p>

  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'ai_countdown_{{ ai_gen_id }}_end';
        this.hiddenKey = 'ai_countdown_{{ ai_gen_id }}_hidden';
        this.timerDisplay = this.querySelector('#ai-countdown-timer-{{ ai_gen_id }}');
        this.durationHours = parseFloat(this.dataset.duration);
        this.intervalId = null;
      }

      connectedCallback() {
        if (this.isHidden()) {
          this.classList.add('ai-countdown-hidden-{{ ai_gen_id }}');
          return;
        }

        this.initializeTimer();
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }
      }

      isHidden() {
        return localStorage.getItem(this.hiddenKey) === 'true';
      }

      initializeTimer() {
        let endTime = localStorage.getItem(this.storageKey);

        if (!endTime) {
          const now = new Date().getTime();
          endTime = now + (this.durationHours * 60 * 60 * 1000);
          localStorage.setItem(this.storageKey, endTime);
        }

        this.endTime = parseInt(endTime);
      }

      startCountdown() {
        this.updateDisplay();

        this.intervalId = setInterval(() => {
          this.updateDisplay();
        }, 1000);
      }

      updateDisplay() {
        const now = new Date().getTime();
        const distance = this.endTime - now;

        if (distance <= 0) {
          this.handleExpired();
          return;
        }

        const hours = Math.floor(distance / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        const formattedTime = 
          String(hours).padStart(2, '0') + ':' +
          String(minutes).padStart(2, '0') + ':' +
          String(seconds).padStart(2, '0');

        this.timerDisplay.textContent = formattedTime;
      }

      handleExpired() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }

        localStorage.setItem(this.hiddenKey, 'true');
        this.classList.add('ai-countdown-hidden-{{ ai_gen_id }}');
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

