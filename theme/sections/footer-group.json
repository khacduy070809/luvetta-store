{"name":"t:sections.footer.name","type":"footer","sections":{"custom_liquid_ERB4qA":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<style>\n  \/* ========================================\n     DAINTY HEART NECKLACE FOOTER\n     Cream \/ Blush \/ Champagne Gold\n     ======================================== *\/\n\n  .heart-footer {\n    --hf-bg: #FFF7F3;\n    --hf-text: #56392F;\n    --hf-muted: #806C64;\n    --hf-accent: #B47E70;\n    --hf-accent-hover: #9F685B;\n    --hf-gold: #C39762;\n    --hf-border: #EAD7C9;\n\n    background: var(--hf-bg);\n    color: var(--hf-text);\n    padding: 55px 24px 0;\n    width: 100%;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .heart-footer *,\n  .heart-footer *::before,\n  .heart-footer *::after {\n    box-sizing: border-box;\n  }\n\n  .heart-footer__inner {\n    max-width: 1160px;\n    margin: 0 auto;\n  }\n\n  \/* ========================================\n     THREE-COLUMN LAYOUT\n     ======================================== *\/\n\n  .heart-footer__top {\n    display: grid;\n    grid-template-columns:\n      minmax(0, 1.3fr)\n      minmax(0, 0.75fr)\n      minmax(0, 1fr);\n\n    column-gap: 65px;\n    row-gap: 35px;\n    align-items: start;\n  }\n\n  \/* ========================================\n     BRAND\n     ======================================== *\/\n\n  .heart-footer__brand {\n    display: flex;\n    align-items: flex-start;\n    gap: 19px;\n  }\n\n  .heart-footer__logo {\n    width: 66px;\n    height: 66px;\n    flex-shrink: 0;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border: 1.5px solid var(--hf-gold);\n    border-radius: 50%;\n\n    background: #FFFCF9;\n    color: var(--hf-accent);\n  }\n\n  .heart-footer__logo svg {\n    width: 33px;\n    height: 33px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.65;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .heart-footer__brand-content {\n    min-width: 0;\n    flex: 1;\n  }\n\n  .heart-footer__brand-title {\n    margin: 0 0 12px;\n\n    font-family:\n      Georgia,\n      \"Times New Roman\",\n      serif;\n\n    font-size: 21px;\n    line-height: 1.25;\n    font-weight: 700;\n\n    color: var(--hf-text);\n  }\n\n  .heart-footer__description {\n    margin: 0;\n    max-width: 320px;\n\n    color: var(--hf-muted);\n    font-size: 13px;\n    font-weight: 400;\n    line-height: 1.85;\n  }\n\n  .heart-footer__signature {\n    display: block;\n    margin-top: 13px;\n\n    color: var(--hf-accent);\n\n    font-family:\n      Georgia,\n      \"Times New Roman\",\n      serif;\n\n    font-size: 13px;\n    font-style: italic;\n  }\n\n  \/* ========================================\n     SECTION HEADINGS\n     ======================================== *\/\n\n  .heart-footer__links h3,\n  .heart-footer__newsletter h3 {\n    margin: 0 0 20px;\n\n    font-family:\n      Georgia,\n      \"Times New Roman\",\n      serif;\n\n    font-size: 21px;\n    line-height: 1.3;\n    font-weight: 700;\n\n    color: var(--hf-text);\n  }\n\n  \/* ========================================\n     QUICK LINKS\n     ======================================== *\/\n\n  .heart-footer__links ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .heart-footer__links li {\n    margin-bottom: 14px;\n  }\n\n  .heart-footer__links a {\n    display: inline-block;\n\n    color: var(--hf-muted);\n    text-decoration: none;\n\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1.55;\n\n    transition: color 0.2s ease;\n  }\n\n  .heart-footer__links a:hover {\n    color: var(--hf-accent);\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  \/* ========================================\n     NEWSLETTER\n     ======================================== *\/\n\n  .heart-footer__newsletter {\n    width: 100%;\n    max-width: 340px;\n    margin: 0;\n  }\n\n  .heart-footer__newsletter-text {\n    margin: 0 0 19px;\n\n    color: var(--hf-muted);\n    font-size: 13px;\n    line-height: 1.8;\n  }\n\n  .heart-footer__form {\n    width: 100%;\n    margin: 0;\n  }\n\n  .heart-footer__input {\n    display: block;\n\n    width: 100%;\n    height: 46px;\n\n    padding: 0 15px;\n\n    border: 1px solid #DCC8BD;\n    border-radius: 7px;\n\n    background: #FFFFFF;\n    color: var(--hf-text);\n\n    font-family: inherit;\n    font-size: 13px;\n\n    outline: none;\n    margin: 0 0 10px;\n\n    transition:\n      border-color 0.2s ease,\n      box-shadow 0.2s ease;\n  }\n\n  .heart-footer__input::placeholder {\n    color: #A18A80;\n    opacity: 1;\n  }\n\n  .heart-footer__input:focus {\n    border-color: var(--hf-accent);\n    box-shadow:\n      0 0 0 3px rgba(180,126,112,0.12);\n  }\n\n  \/* SIGN UP BUTTON *\/\n\n  .heart-footer__button {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n\n    width: 100%;\n    min-height: 46px;\n\n    padding: 11px 18px;\n\n    border: none;\n    border-radius: 7px;\n\n    background: var(--hf-accent);\n    color: #FFFFFF;\n\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: 0.3px;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .heart-footer__button:hover {\n    background: var(--hf-accent-hover);\n    transform: translateY(-1px);\n  }\n\n  .heart-footer__button:active {\n    transform: translateY(0);\n  }\n\n  .heart-footer__button:focus-visible,\n  .heart-footer__top-btn:focus-visible,\n  .heart-footer__links a:focus-visible {\n    outline: 2px solid var(--hf-accent);\n    outline-offset: 3px;\n  }\n\n  .heart-footer__button-heart {\n    font-size: 19px;\n    line-height: 1;\n    font-weight: 400;\n  }\n\n  .heart-footer__newsletter-note {\n    margin: 12px 0 0;\n\n    font-size: 11px;\n    line-height: 1.65;\n    color: #977E73;\n  }\n\n  \/* FORM MESSAGES *\/\n\n  .heart-footer__success {\n    margin: 12px 0 0;\n\n    padding: 11px 12px;\n\n    background: #ECF5EB;\n    border: 1px solid #C8E0C5;\n    border-radius: 7px;\n\n    color: #365E39;\n\n    font-size: 12px;\n    line-height: 1.5;\n  }\n\n  .heart-footer__error {\n    margin: 12px 0 0;\n\n    padding: 11px 12px;\n\n    background: #FFF0EE;\n    border: 1px solid #E6BBB5;\n    border-radius: 7px;\n\n    color: #A0443B;\n\n    font-size: 12px;\n    line-height: 1.5;\n  }\n\n  \/* ========================================\n     FOOTER BOTTOM\n     ======================================== *\/\n\n  .heart-footer__bottom {\n    margin-top: 43px;\n\n    border-top: 1px solid var(--hf-border);\n\n    padding: 25px 0 20px;\n    text-align: center;\n  }\n\n  \/* PAYMENT ICONS *\/\n\n  .heart-footer__payments {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n\n    gap: 7px;\n    margin-bottom: 15px;\n  }\n\n  .heart-footer__payments svg {\n    display: block;\n    width: 38px;\n    height: auto;\n    max-height: 27px;\n  }\n\n  .heart-footer__copyright {\n    margin: 0;\n\n    font-size: 11px;\n    line-height: 1.5;\n\n    color: var(--hf-muted);\n  }\n\n  .heart-footer__copyright-heart {\n    color: var(--hf-accent);\n  }\n\n  \/* ========================================\n     BACK TO TOP BUTTON\n     ======================================== *\/\n\n  .heart-footer__top-btn {\n    position: fixed;\n\n    right: 20px;\n    bottom: 20px;\n\n    width: 42px;\n    height: 42px;\n\n    padding: 0;\n\n    border: 1px solid rgba(255,255,255,0.7);\n    border-radius: 50%;\n\n    background: var(--hf-accent);\n    color: #FFFFFF;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    box-shadow:\n      0 5px 17px rgba(86,57,47,0.19);\n\n    cursor: pointer;\n\n    z-index: 20;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .heart-footer__top-btn svg {\n    width: 21px;\n    height: 21px;\n\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2.1;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .heart-footer__top-btn:hover {\n    background: var(--hf-accent-hover);\n    transform: translateY(-3px);\n  }\n\n  \/* ========================================\n     TABLET\n     ======================================== *\/\n\n  @media screen and (max-width: 950px) {\n\n    .heart-footer__top {\n      grid-template-columns: 1fr 1fr;\n      gap: 35px;\n    }\n\n    .heart-footer__newsletter {\n      grid-column: 1 \/ -1;\n      max-width: 430px;\n    }\n\n  }\n\n  \/* ========================================\n     MOBILE\n     ======================================== *\/\n\n  @media screen and (max-width: 640px) {\n\n    .heart-footer {\n      padding: 40px 20px 0;\n    }\n\n    .heart-footer__top {\n      grid-template-columns: 1fr;\n      gap: 34px;\n    }\n\n    .heart-footer__brand {\n      gap: 17px;\n    }\n\n    .heart-footer__logo {\n      width: 58px;\n      height: 58px;\n    }\n\n    .heart-footer__logo svg {\n      width: 30px;\n      height: 30px;\n    }\n\n    .heart-footer__brand-title {\n      font-size: 19px;\n    }\n\n    .heart-footer__description {\n      font-size: 12.5px;\n      max-width: none;\n    }\n\n    .heart-footer__links h3,\n    .heart-footer__newsletter h3 {\n      font-size: 20px;\n      margin-bottom: 16px;\n    }\n\n    .heart-footer__newsletter {\n      grid-column: auto;\n      max-width: none;\n    }\n\n    .heart-footer__newsletter-text {\n      font-size: 12.5px;\n    }\n\n    .heart-footer__bottom {\n      margin-top: 34px;\n      padding: 23px 0 18px;\n    }\n\n    .heart-footer__top-btn {\n      width: 39px;\n      height: 39px;\n      right: 14px;\n      bottom: 14px;\n    }\n\n  }\n\n  \/* REDUCED MOTION *\/\n\n  @media (prefers-reduced-motion: reduce) {\n\n    .heart-footer__button,\n    .heart-footer__top-btn,\n    .heart-footer__links a {\n      transition: none;\n    }\n\n  }\n\n<\/style>\n\n\n<!-- ========================================\n     FOOTER HTML\n     ======================================== -->\n\n<footer class=\"heart-footer\">\n\n  <div class=\"heart-footer__inner\">\n\n    <div class=\"heart-footer__top\">\n\n      <!-- BRAND COLUMN -->\n\n      <div class=\"heart-footer__brand\">\n\n        <!-- HEART ICON -->\n\n        <div class=\"heart-footer__logo\">\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            xmlns=\"http:\/\/www.w3.org\/2000\/svg\"\n            aria-hidden=\"true\"\n          >\n\n            <path\n              d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z\"\n            \/>\n\n          <\/svg>\n\n        <\/div>\n\n        <!-- BRAND DESCRIPTION -->\n\n        <div class=\"heart-footer__brand-content\">\n\n          <h3 class=\"heart-footer__brand-title\">\n            Little Details, Big Meaning ♡\n          <\/h3>\n\n          <p class=\"heart-footer__description\">\n\n            A tiny heart. A letter that's all yours.\n\n            Discover delicate initial necklaces\n            made for everyday styling,\n            thoughtful gifting, and the little\n            moments that mean the most.\n\n            Choose your favorite letter from\n            A–Z in Gold or Silver,\n            and make it uniquely yours.\n\n          <\/p>\n\n          <span class=\"heart-footer__signature\">\n            Made to feel personal. ♡\n          <\/span>\n\n        <\/div>\n\n      <\/div>\n\n\n      <!-- ========================================\n           QUICK LINKS COLUMN\n           ======================================== -->\n\n      <nav\n        class=\"heart-footer__links\"\n        aria-label=\"Footer quick links\"\n      >\n\n        <h3>\n          Quick Links\n        <\/h3>\n\n        <ul>\n\n          <!-- SEARCH -->\n\n          <li>\n\n            <a href=\"{{ routes.search_url }}\">\n              Search\n            <\/a>\n\n          <\/li>\n\n          <!-- PRIVACY POLICY -->\n\n          {% if shop.privacy_policy != blank %}\n\n            <li>\n\n              <a href=\"{{ shop.privacy_policy.url }}\">\n                Privacy Policy\n              <\/a>\n\n            <\/li>\n\n          {% endif %}\n\n          <!-- REFUND POLICY -->\n\n          {% if shop.refund_policy != blank %}\n\n            <li>\n\n              <a href=\"{{ shop.refund_policy.url }}\">\n                Refund Policy\n              <\/a>\n\n            <\/li>\n\n          {% endif %}\n\n          <!-- TERMS OF SERVICE -->\n\n          {% if shop.terms_of_service != blank %}\n\n            <li>\n\n              <a href=\"{{ shop.terms_of_service.url }}\">\n                Terms of Service\n              <\/a>\n\n            <\/li>\n\n          {% endif %}\n\n          <!-- SHIPPING POLICY -->\n\n          {% if shop.shipping_policy != blank %}\n\n            <li>\n\n              <a href=\"{{ shop.shipping_policy.url }}\">\n                Shipping Policy\n              <\/a>\n\n            <\/li>\n\n          {% endif %}\n\n        <\/ul>\n\n      <\/nav>\n\n\n      <!-- ========================================\n           EMAIL NEWSLETTER COLUMN\n           ======================================== -->\n\n      <div class=\"heart-footer__newsletter\">\n\n        <h3>\n          A Little Love in Your Inbox ♡\n        <\/h3>\n\n        <p class=\"heart-footer__newsletter-text\">\n\n          Be the first to hear about\n          new arrivals, sweet little offers,\n          and jewelry styling inspiration.\n\n          A little something special,\n          delivered to your inbox.\n\n        <\/p>\n\n        <!-- SHOPIFY NEWSLETTER FORM -->\n\n        {% form 'customer', class: 'heart-footer__form' %}\n\n          <!-- NEWSLETTER TAG -->\n\n          <input\n            type=\"hidden\"\n            name=\"contact[tags]\"\n            value=\"newsletter\"\n          >\n\n          <!-- EMAIL INPUT -->\n\n          <input\n            class=\"heart-footer__input\"\n            type=\"email\"\n            name=\"contact[email]\"\n            value=\"{{ form.email | escape }}\"\n            placeholder=\"Enter your email address\"\n            aria-label=\"Email address\"\n            autocorrect=\"off\"\n            autocapitalize=\"off\"\n            autocomplete=\"email\"\n            required\n          >\n\n          <!-- SUBSCRIBE BUTTON -->\n\n          <button\n            type=\"submit\"\n            class=\"heart-footer__button\"\n          >\n\n            Sign Me Up\n\n            <span\n              class=\"heart-footer__button-heart\"\n              aria-hidden=\"true\"\n            >\n              ♡\n            <\/span>\n\n          <\/button>\n\n          <!-- SUCCESS MESSAGE -->\n\n          {% if form.posted_successfully? %}\n\n            <p\n              class=\"heart-footer__success\"\n              role=\"status\"\n            >\n\n              Thank you for joining!\n              So happy to have you here. ♡\n\n            <\/p>\n\n          {% endif %}\n\n          <!-- ERROR MESSAGE -->\n\n          {% if form.errors %}\n\n            <div\n              class=\"heart-footer__error\"\n              role=\"alert\"\n            >\n\n              {{ form.errors | default_errors }}\n\n            <\/div>\n\n          {% endif %}\n\n        {% endform %}\n\n        <p class=\"heart-footer__newsletter-note\">\n          Just sweet updates. Unsubscribe anytime.\n        <\/p>\n\n      <\/div>\n\n    <\/div>\n\n\n    <!-- ========================================\n         FOOTER BOTTOM\n         ======================================== -->\n\n    <div class=\"heart-footer__bottom\">\n\n      <!-- PAYMENT METHODS -->\n\n      {% if shop.enabled_payment_types.size > 0 %}\n\n        <div\n          class=\"heart-footer__payments\"\n          aria-label=\"Accepted payment methods\"\n        >\n\n          {% for type in shop.enabled_payment_types %}\n\n            {{\n              type\n              | payment_type_svg_tag:\n                class: 'heart-footer__payment-icon'\n            }}\n\n          {% endfor %}\n\n        <\/div>\n\n      {% endif %}\n\n      <!-- COPYRIGHT -->\n\n      <p class=\"heart-footer__copyright\">\n\n        © {{ 'now' | date: '%Y' }},\n        {{ shop.name | escape }}.\n\n        Made with\n        <span class=\"heart-footer__copyright-heart\">\n          ♡\n        <\/span>\n\n      <\/p>\n\n    <\/div>\n\n  <\/div>\n\n\n  <!-- ========================================\n       BACK TO TOP\n       ======================================== -->\n\n  <button\n    class=\"heart-footer__top-btn\"\n    type=\"button\"\n    aria-label=\"Back to top\"\n    title=\"Back to top\"\n    onclick=\"window.scrollTo({top: 0, behavior: 'smooth'})\"\n  >\n\n    <svg\n      viewBox=\"0 0 24 24\"\n      xmlns=\"http:\/\/www.w3.org\/2000\/svg\"\n      aria-hidden=\"true\"\n    >\n\n      <path d=\"M6 14L12 8L18 14\" \/>\n\n    <\/svg>\n\n  <\/button>\n\n<\/footer>","color_scheme":"background-1","padding_top":0,"padding_bottom":0}},"footer":{"type":"footer","disabled":true,"settings":{"color_scheme":"accent-1","enable_follow_on_shop":false,"show_social":false,"enable_country_selector":false,"enable_language_selector":true,"payment_enable":true,"enabled_payment_types":"","show_policy":false,"branding_text":"","margin_top":0,"padding_top":32,"padding_bottom":20,"custom_colors_background":"#121212","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#ffffff","custom_colors_solid_button_text":"#121212","custom_colors_outline_button":"#ffffff"}}},"order":["custom_liquid_ERB4qA","footer"]}