{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":36,"padding_bottom":36}},"newsletter":{"type":"newsletter","blocks":{"heading":{"type":"heading","settings":{"title":"Subscribe to our emails","title_highlight_color":"#6d388b","heading_size":"h1"}},"paragraph":{"type":"paragraph","settings":{"text":"<p>Join our email list for exclusive offers and the latest news. <\/p>"}},"email-form":{"type":"email_form","settings":{}}},"block_order":["heading","paragraph","email-form"],"disabled":true,"settings":{"display_id":false,"visibility":"always-display","button_type":"solid","button_label":"Sign up","button_style_secondary":false,"color_scheme":"background-2","full_width":true,"padding_top":68,"padding_bottom":52,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff"}},"custom_liquid_Wyrp77":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"{% comment %}\n=========================================\nLUVETTA SHOP - ABOUT US PAGE\nCREAM & BLUSH EDITION\n\nBrand: Luvetta Shop\nProduct: Dainty Heart Initial Necklace\n\n8 CONTENT SECTIONS\nNO NEWSLETTER\nNO FOOTER\nRESPONSIVE DESIGN\n=========================================\n{% endcomment %}\n\n{% assign luvetta_about_id = 'luvetta-about-' | append: section.id %}\n\n<section id=\"{{ luvetta_about_id }}\" class=\"luvetta-about\">\n\n  <div class=\"luvetta-about__container\">\n\n    <!-- PAGE TITLE -->\n\n    <header class=\"luvetta-about__header\">\n      <h1>ABOUT US<\/h1>\n      <div class=\"luvetta-about__title-decoration\">\n        <span><\/span>\n        <span class=\"luvetta-about__heart\">♡<\/span>\n        <span><\/span>\n      <\/div>\n    <\/header>\n\n\n    <!-- ====================================\n         SECTION 1: OUR STORY\n         ==================================== -->\n\n    <div class=\"luvetta-about__section\">\n\n      <h2>Our Story<\/h2>\n\n      <p>\n        At <strong>Luvetta Shop<\/strong>, we believe\n        the smallest things can hold the biggest meaning.\n      <\/p>\n\n      <p>\n        A simple letter can tell a beautiful story.\n        It might be the first letter of your name,\n        the initial of someone you love,\n        or a little reminder of a memory\n        you never want to forget.\n      <\/p>\n\n      <p>\n        That's what we love about personalized jewelry.\n      <\/p>\n\n      <p>\n        It doesn't need to be big, expensive,\n        or complicated to feel special.\n      <\/p>\n\n      <p>\n        Sometimes, all it takes is\n        <strong>a tiny heart and one meaningful letter.<\/strong>\n      <\/p>\n\n      <p>\n        Our Dainty Heart Initial Necklace\n        brings those two little details together\n        in a delicate design that feels personal\n        without trying too hard.\n      <\/p>\n\n      <p>\n        Whether it's your own initial,\n        your partner's, your best friend's,\n        or someone who means the world to you,\n        every letter carries its own meaning.\n      <\/p>\n\n      <p>\n        And that's the idea behind Luvetta Shop:\n        jewelry that isn't just something you wear,\n        but something that reminds you\n        of what matters most.\n      <\/p>\n\n      <p class=\"luvetta-about__emphasis\">\n        A little heart. A letter that's yours. ♡\n      <\/p>\n\n    <\/div>\n\n\n    <!-- ====================================\n         SECTION 2: OUR MISSION\n         ==================================== -->\n\n    <div class=\"luvetta-about__section\">\n\n      <h2>Our Mission<\/h2>\n\n      <p>\n        We believe jewelry should feel\n        as personal as the person wearing it.\n      <\/p>\n\n      <p>\n        Our mission at Luvetta Shop is simple:\n        to make meaningful, everyday jewelry\n        feel accessible, beautiful, and easy to choose.\n      <\/p>\n\n      <p>\n        We love pieces that can fit naturally\n        into your everyday life.\n      <\/p>\n\n      <p>\n        Something you can wear with your\n        favorite sweater.\n      <\/p>\n\n      <p>\n        With a simple white tee.\n      <\/p>\n\n      <p>\n        On a coffee date, at work,\n        or during an ordinary afternoon\n        that turns into a special memory.\n      <\/p>\n\n      <p>\n        We want our jewelry to feel like\n        a small part of your story,\n        rather than something you save\n        only for special occasions.\n      <\/p>\n\n      <p class=\"luvetta-about__emphasis\">\n        Because the little details\n        are often the ones we remember.\n      <\/p>\n\n    <\/div>\n\n\n    <!-- ====================================\n         SECTION 3: OUR COMMITMENT\n         ==================================== -->\n\n    <div class=\"luvetta-about__section\">\n\n      <h2>Our Commitment<\/h2>\n\n      <h3>Personal Jewelry, Meaningful Choices<\/h3>\n\n      <p>\n        We believe choosing jewelry should\n        be an enjoyable and personal experience.\n      <\/p>\n\n      <p>\n        That's why we focus on designs\n        that let you express something meaningful\n        through the smallest details.\n      <\/p>\n\n      <p>\n        With our Dainty Heart Initial Necklace,\n        you can choose the letter\n        that matters most to you.\n      <\/p>\n\n      <p><strong>Your initial.<\/strong><\/p>\n\n      <p><strong>Their initial.<\/strong><\/p>\n\n      <p>\n        <strong>A letter with a story behind it.<\/strong>\n      <\/p>\n\n      <p>\n        We also believe in being clear\n        about the products we offer,\n        giving you the information you need\n        to make a choice that feels right.\n      <\/p>\n\n      <p>\n        And when you have a question,\n        we want you to feel comfortable\n        reaching out to us.\n      <\/p>\n\n      <p class=\"luvetta-about__emphasis\">\n        Little details. Real meaning.\n        A personal touch. ♡\n      <\/p>\n\n    <\/div>\n\n\n    <!-- ====================================\n         SECTION 4: PERSONALIZATION\n         ==================================== -->\n\n    <div class=\"luvetta-about__section\">\n\n      <h2>A Letter That Means Something<\/h2>\n\n      <p>\n        No two people share exactly the same story.\n      <\/p>\n\n      <p>\n        So why should every necklace\n        feel exactly the same?\n      <\/p>\n\n      <p>\n        Our Dainty Heart Initial Necklace\n        lets you choose from\n        <strong>26 letters, A–Z<\/strong>,\n        available in\n        <strong>Gold or Silver finishes.<\/strong>\n      <\/p>\n\n      <p>\n        A tiny heart sits beside your chosen letter,\n        creating a delicate combination\n        of simplicity and personal meaning.\n      <\/p>\n\n      <p>\n        Maybe you choose the first letter\n        of your own name.\n      <\/p>\n\n      <p>\n        Maybe it's the initial\n        of someone you miss.\n      <\/p>\n\n      <p>\n        Or perhaps it's a letter\n        that represents a beautiful\n        new chapter in your life.\n      <\/p>\n\n      <p>\n        Whatever the reason,\n        the meaning belongs to you.\n      <\/p>\n\n      <p class=\"luvetta-about__emphasis\">\n        One letter. Endless stories.\n      <\/p>\n\n    <\/div>\n\n\n    <!-- ====================================\n         SECTION 5: MORE THAN JEWELRY\n         ==================================== -->\n\n    <div class=\"luvetta-about__section\">\n\n      <h2>More Than Just Jewelry<\/h2>\n\n      <p>\n        To us, jewelry isn't only about\n        how something looks.\n      <\/p>\n\n      <p>\n        It's also about how it makes you feel.\n      <\/p>\n\n      <p>\n        A familiar initial can bring\n        a little comfort.\n      <\/p>\n\n      <p>\n        A tiny heart can remind you\n        of someone special.\n      <\/p>\n\n      <p>\n        And a thoughtful gift can\n        turn an ordinary moment\n        into a memory worth keeping.\n      <\/p>\n\n      <p>\n        That's why we love jewelry\n        with a personal meaning.\n      <\/p>\n\n      <p>It can be simple.<\/p>\n\n      <p>It can be delicate.<\/p>\n\n      <p>\n        It can be something you wear\n        almost without thinking.\n      <\/p>\n\n      <p>\n        Yet every time you notice it,\n        it can remind you of something wonderful.\n      <\/p>\n\n      <p class=\"luvetta-about__emphasis\">\n        Sometimes the smallest pieces\n        carry the biggest feelings. ♡\n      <\/p>\n\n    <\/div>\n\n\n    <!-- ====================================\n         SECTION 6: EVERYDAY STYLE\n         ==================================== -->\n\n    <div class=\"luvetta-about__section\">\n\n      <h2>Made for Everyday Moments<\/h2>\n\n      <p>\n        Beautiful jewelry doesn't have to wait\n        for a special occasion.\n      <\/p>\n\n      <p>\n        We love delicate pieces that\n        complement everyday outfits\n        without taking over your look.\n      <\/p>\n\n      <p>A little detail around your neck.<\/p>\n\n      <p>A touch of Gold or Silver.<\/p>\n\n      <p>\n        A heart and a letter\n        that feel uniquely yours.\n      <\/p>\n\n      <p>\n        From quiet mornings at home\n        to dinner with friends,\n        our initial necklace is designed\n        with simple, versatile styling in mind.\n      <\/p>\n\n      <p>\n        Wear it on its own\n        for a minimal look.\n      <\/p>\n\n      <p>\n        Or pair it with other favorite pieces\n        to express your personal style.\n      <\/p>\n\n      <p>There are no complicated rules.<\/p>\n\n      <p>\n        Just choose the letter you love\n        and wear it your way.\n      <\/p>\n\n      <p class=\"luvetta-about__emphasis\">\n        Everyday style, with a little more meaning.\n      <\/p>\n\n    <\/div>\n\n\n    <!-- ====================================\n         SECTION 7: GIFTING\n         ==================================== -->\n\n    <div class=\"luvetta-about__section\">\n\n      <h2>A Thoughtful Gift, Just Because<\/h2>\n\n      <p>\n        Some of the best gifts\n        are the ones that feel personal.\n      <\/p>\n\n      <p>\n        Not because they're the biggest\n        or the most expensive.\n      <\/p>\n\n      <p>\n        But because someone took the time\n        to think about what would make\n        you smile.\n      <\/p>\n\n      <p>\n        A personalized initial necklace\n        can be a sweet little surprise\n        for so many moments.\n      <\/p>\n\n      <p><strong>Birthdays.<\/strong><\/p>\n\n      <p><strong>Anniversaries.<\/strong><\/p>\n\n      <p><strong>Friendship gifts.<\/strong><\/p>\n\n      <p><strong>A little thank-you.<\/strong><\/p>\n\n      <p><strong>Or simply, just because.<\/strong><\/p>\n\n      <p>\n        It's also a lovely way\n        to celebrate yourself.\n      <\/p>\n\n      <p>\n        You don't need to wait\n        for somebody else to give you\n        something meaningful.\n      <\/p>\n\n      <p>\n        Sometimes, a little gift\n        from you to you is enough.\n      <\/p>\n\n      <p class=\"luvetta-about__emphasis\">\n        A little gift. A lot of love. ♡\n      <\/p>\n\n    <\/div>\n\n\n    <!-- ====================================\n         SECTION 8: JOIN US\n         ==================================== -->\n\n    <div class=\"luvetta-about__section luvetta-about__last\">\n\n      <h2>Join Us<\/h2>\n\n      <p>\n        There's something we hope\n        every Luvetta Shop customer experiences.\n      <\/p>\n\n      <p>\n        Not just finding a pretty necklace.\n      <\/p>\n\n      <p>\n        But finding a little piece\n        that feels like their own.\n      <\/p>\n\n      <p>\n        A reminder of someone they love.\n      <\/p>\n\n      <p>\n        A memory worth holding onto.\n      <\/p>\n\n      <p>\n        Or simply a small detail\n        that makes an ordinary day\n        feel a little more special.\n      <\/p>\n\n      <p>\n        That's what Luvetta Shop\n        is all about.\n      <\/p>\n\n      <p>Meaningful little moments.<\/p>\n\n      <p>Personal stories.<\/p>\n\n      <p>\n        And the simple beauty\n        of keeping something close\n        to your heart.\n      <\/p>\n\n      <p>\n        Thank you for being\n        part of our story.\n      <\/p>\n\n      <p class=\"luvetta-about__closing\">\n        Luvetta Shop —\n        A Little Heart. A Letter That's Yours. ♡\n      <\/p>\n\n    <\/div>\n\n  <\/div>\n\n<\/section>\n\n\n<style>\n\n  \/* ======================================\n     LUVETTA COLOR PALETTE\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} {\n\n    --lv-bg: #FFF7F3;\n\n    --lv-heading: #56392F;\n\n    --lv-text: #5F4B43;\n\n    --lv-muted: #806C64;\n\n    --lv-accent: #B47E70;\n\n    --lv-gold: #C39762;\n\n    --lv-line: #EAD7C9;\n\n    width: 100%;\n\n    background: var(--lv-bg);\n\n    color: var(--lv-text);\n\n    padding: 60px 24px 85px;\n\n    font-family: inherit;\n\n    box-sizing: border-box;\n\n  }\n\n  #{{ luvetta_about_id }} *,\n  #{{ luvetta_about_id }} *::before,\n  #{{ luvetta_about_id }} *::after {\n\n    box-sizing: border-box;\n\n  }\n\n\n  \/* ======================================\n     CENTERED CONTENT CONTAINER\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__container {\n\n    width: 100%;\n\n    max-width: 660px;\n\n    margin: 0 auto;\n\n  }\n\n\n  \/* ======================================\n     ABOUT US MAIN TITLE\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__header {\n\n    text-align: center;\n\n    margin: 0 0 45px;\n\n  }\n\n  #{{ luvetta_about_id }} .luvetta-about__header h1 {\n\n    margin: 0;\n\n    font-family:\n      Georgia,\n      \"Times New Roman\",\n      serif;\n\n    font-size: clamp(32px, 4vw, 42px);\n\n    font-weight: 800;\n\n    line-height: 1.2;\n\n    letter-spacing: 0.5px;\n\n    color: var(--lv-heading);\n\n  }\n\n\n  \/* ======================================\n     DECORATIVE HEART UNDER TITLE\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__title-decoration {\n\n    display: flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    gap: 13px;\n\n    margin-top: 15px;\n\n  }\n\n  #{{ luvetta_about_id }} .luvetta-about__title-decoration > span:not(.luvetta-about__heart) {\n\n    width: 55px;\n\n    height: 1px;\n\n    background: var(--lv-gold);\n\n    opacity: 0.65;\n\n  }\n\n  #{{ luvetta_about_id }} .luvetta-about__heart {\n\n    color: var(--lv-accent);\n\n    font-size: 26px;\n\n    line-height: 1;\n\n  }\n\n\n  \/* ======================================\n     CONTENT SECTIONS\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__section {\n\n    padding: 0 0 38px;\n\n    margin: 0 0 42px;\n\n    border-bottom: 1px solid var(--lv-line);\n\n  }\n\n\n  \/* ======================================\n     SECTION HEADINGS\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__section h2 {\n\n    color: var(--lv-heading);\n\n    font-family:\n      Georgia,\n      \"Times New Roman\",\n      serif;\n\n    font-size: clamp(22px, 2.5vw, 27px);\n\n    line-height: 1.35;\n\n    font-weight: 700;\n\n    margin: 0 0 18px;\n\n  }\n\n\n  \/* ======================================\n     SECTION SUBHEADINGS\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__section h3 {\n\n    color: var(--lv-accent);\n\n    font-family:\n      Georgia,\n      \"Times New Roman\",\n      serif;\n\n    font-size: 17px;\n\n    font-weight: 700;\n\n    line-height: 1.45;\n\n    margin: 0 0 15px;\n\n  }\n\n\n  \/* ======================================\n     PARAGRAPHS\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__section p {\n\n    color: var(--lv-text);\n\n    font-size: 14px;\n\n    line-height: 1.85;\n\n    letter-spacing: 0.1px;\n\n    font-weight: 400;\n\n    margin: 0 0 13px;\n\n    overflow-wrap: anywhere;\n\n  }\n\n\n  \/* ======================================\n     BOLD TEXT\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__section strong {\n\n    color: var(--lv-heading);\n\n    font-weight: 700;\n\n  }\n\n\n  \/* ======================================\n     SPECIAL HIGHLIGHTED SENTENCES\n     ====================================== *\/\n\n  #{{ luvetta_about_id }}\n  .luvetta-about__section\n  .luvetta-about__emphasis {\n\n    color: var(--lv-accent);\n\n    font-size: 14px;\n\n    line-height: 1.75;\n\n    font-weight: 700;\n\n    margin-top: 20px;\n\n    margin-bottom: 0;\n\n  }\n\n\n  \/* ======================================\n     FINAL SECTION\n     ====================================== *\/\n\n  #{{ luvetta_about_id }} .luvetta-about__last {\n\n    border-bottom: none;\n\n    padding-bottom: 0;\n\n    margin-bottom: 0;\n\n  }\n\n\n  \/* ======================================\n     FINAL BRAND MESSAGE\n     ====================================== *\/\n\n  #{{ luvetta_about_id }}\n  .luvetta-about__section\n  .luvetta-about__closing {\n\n    color: var(--lv-accent);\n\n    font-size: 15px;\n\n    line-height: 1.75;\n\n    font-weight: 800;\n\n    margin: 23px 0 0;\n\n  }\n\n\n  \/* ======================================\n     TABLET RESPONSIVE\n     ====================================== *\/\n\n  @media screen and (max-width: 900px) {\n\n    #{{ luvetta_about_id }} {\n\n      padding: 48px 25px 72px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__container {\n\n      max-width: 620px;\n\n    }\n\n  }\n\n\n  \/* ======================================\n     MOBILE RESPONSIVE\n     ====================================== *\/\n\n  @media screen and (max-width: 749px) {\n\n    #{{ luvetta_about_id }} {\n\n      padding: 38px 20px 58px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__header {\n\n      margin-bottom: 35px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__header h1 {\n\n      font-size: 32px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__section {\n\n      padding-bottom: 29px;\n\n      margin-bottom: 33px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__section h2 {\n\n      font-size: 22px;\n\n      margin-bottom: 15px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__section h3 {\n\n      font-size: 16px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__section p {\n\n      font-size: 13.5px;\n\n      line-height: 1.8;\n\n      margin-bottom: 12px;\n\n    }\n\n    #{{ luvetta_about_id }}\n    .luvetta-about__section\n    .luvetta-about__emphasis {\n\n      font-size: 13.5px;\n\n    }\n\n    #{{ luvetta_about_id }} .luvetta-about__last {\n\n      margin-bottom: 0;\n\n      padding-bottom: 0;\n\n    }\n\n  }\n\n<\/style>","color_scheme":"background-1","padding_top":0,"padding_bottom":0}}},"order":["main","newsletter","custom_liquid_Wyrp77"]}